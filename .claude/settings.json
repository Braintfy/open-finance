{
  "_comment": "ПРЕДЛОЖЕНИЕ конфига Claude Code (permissions + hooks). Активация — осознанное действие пользователя: проверь содержимое и выполни  mv .claude/settings.proposed.json .claude/settings.json  (AI-агент сам этот файл не активирует). allow — безопасные read-only/verify команды без промптов; deny — жёсткие правила проекта (git-мутации, миграции, .env); hook — аналог path-scoped правил Cursor.",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm format:*)",
      "Bash(pnpm tsx scripts/test-:*)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm docker:logs)",
      "Bash(pnpm ollama:check)",
      "Bash(rm -rf .next)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(curl http://localhost:3111/agentmemory/health)",
      "mcp__agentmemory__memory_recall",
      "mcp__agentmemory__memory_smart_search",
      "mcp__agentmemory__memory_sessions",
      "mcp__agentmemory__memory_audit",
      "mcp__agentmemory__memory_save"
    ],
    "ask": [
      "Bash(docker exec:*)",
      "Bash(./scripts/install-hooks.sh)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm db:studio)",
      "mcp__agentmemory__memory_governance_delete"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git filter-repo:*)",
      "Bash(pnpm db:push)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm admin:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.development)",
      "Write(./.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-rules-hint.sh"
          }
        ]
      }
    ]
  }
}
