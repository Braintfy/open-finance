# =============================================================================
# Open Finance — environment variables (template)
# =============================================================================
# Скопируй в .env.local и заполни. НЕ коммить .env.local в гит!
# Подробности: docs/SECURITY.md

# === Окружение ===
NODE_ENV=development

# === Database (PostgreSQL + pgvector) ===
# Порт 5434 чтобы не конфликтовать с другими локальными Postgres (например, braint на 5432)
POSTGRES_DB=openfinance_dev
POSTGRES_USER=openfinance_user
POSTGRES_PASSWORD=openfinance_local_dev
POSTGRES_PORT=5434
DATABASE_URL=postgresql://openfinance_user:openfinance_local_dev@localhost:5434/openfinance_dev

# === Redis (cache + queue) ===
# Порт 6380 чтобы не конфликтовать с другими Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# === MinIO (S3-совместимое хранилище для Inbox файлов) ===
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=openfinance_minio
MINIO_ROOT_PASSWORD=openfinance_minio_local_dev

# === Adminer (web UI для Postgres) ===
ADMINER_PORT=8081

# === NextAuth / Session ===
# Минимум 32 символа. В dev можно оставить пустым — заработает fallback.
# В проде ОБЯЗАТЕЛЬНО задать. Сгенерировать: openssl rand -base64 48
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# === Шифрование секретов интеграций (AES-256-GCM) ===
# INBOX_SECRET_KEY — ключ для секретов inbox-каналов И (по умолчанию) маркетплейсов.
# В dev — fallback, в проде ОБЯЗАТЕЛЬНО задать. Сгенерировать: openssl rand -base64 48
INBOX_SECRET_KEY=
# MARKETPLACE_SECRET_KEY (I5) — отдельный ключ для API-ключей маркетплейсов.
# Если пусто — используется INBOX_SECRET_KEY. При смене на новый ключ старые
# креды читаются по legacy-fallback (см. src/lib/marketplaces/crypto.ts).
MARKETPLACE_SECRET_KEY=

# === Yandex SmartCaptcha (I6 — защита форм входа/регистрации/сброса) ===
# Оба ключа из Yandex Cloud → SmartCaptcha (см. docs/SMARTCAPTCHA.md).
# Если пусто — капча выключена (удобно для dev).
# Публичный ключ (client) уходит в браузер → ОБЯЗАТЕЛЬНО префикс NEXT_PUBLIC_.
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY=
# Секретный ключ (server) — только на сервере, для проверки токена.
YANDEX_SMARTCAPTCHA_SERVER_KEY=

# === AI Providers (по умолчанию пусто, BYOK — Bring Your Own Key) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
YANDEX_API_KEY=
# Через какой провайдер ходить по умолчанию: anthropic | openai | yandex | ollama | mock
AI_DEFAULT_PROVIDER=mock

# === Локальная модель в dev (Ollama) ===
# См. docs/LOCAL_AI.md как поднять Ollama. Если запущено — DEV получит работающий AI бесплатно.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# Включить мок-провайдер (детерминированные ответы для разработки и e2e тестов)
AI_MOCK_ENABLED=true

# === VPN-прокси для зарубежных AI API (Anthropic/OpenAI из РФ) ===
# Заполняется в админке /admin/vpn. Здесь — только дефолт для CLI задач.
AI_PROXY_URL=
AI_PROXY_USERNAME=
AI_PROXY_PASSWORD=

# === Xray / VLESS (управление VPN из админки) ===
# Spool-конфиг, куда web-процесс пишет валидированный config.json (0600).
# Его подхватывает root-овый systemd path-юнит (deploy/xray/of-xray-apply.path).
# Директория должна быть writable пользователем приложения. Дефолт:
XRAY_SPOOL_PATH=/var/lib/open-finance/xray/config.json

# === S3 Storage (для inbox в SaaS; в dev — MinIO) ===
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=openfinance-inbox
S3_ACCESS_KEY=openfinance_minio
S3_SECRET_KEY=openfinance_minio_local_dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# === Telegram Bot (для уведомлений) ===
TELEGRAM_BOT_TOKEN=

# === Биллинг: Т-Касса ===
TKASSA_TERMINAL_KEY=
TKASSA_TERMINAL_PASSWORD=

# === Биллинг: CloudPayments (резервный) ===
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_PASSWORD=

# === Sentry (мониторинг ошибок) ===
SENTRY_DSN=

# === Feature flags ===
# Открытая регистрация vs by-invite (можно переопределить в админке /admin/settings)
FEATURE_OPEN_REGISTRATION=true
# Включить онбординг-визард при первом входе пользователя
FEATURE_ONBOARDING_WIZARD=true
# Билинг-заглушка: всегда success, без обращений к Т-Кассе/CloudPayments
FEATURE_BILLING_MOCK=true
# Тариф по умолчанию для новых tenant-ов: free | trial | pro | business.
# Для личного self-hosted инстанса ставь pro — снимает plan-гейт (лимит 1 МП-аккаунта).
FEATURE_DEFAULT_PLAN=trial

# === Auth strategy ===
# Какой драйвер NextAuth: v5 (default) | v4 (fallback если v5 beta сломается)
AUTH_DRIVER=v5

# === SMTP (рассылка почты) ===
# Beget: smtp.beget.com:465 (SSL) или :2525 (TLS).
# Если пусто — письма пишутся в консоль (dev fallback).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Open Finance <noreply@yourdomain.ru>

# === App URL (для ссылок в письмах) ===
APP_URL=http://localhost:3000

# === Seed (дефолтный super-admin при `pnpm db:seed`) ===
# ВАЖНО: смените пароль перед продом или удалите этого юзера
SEED_ADMIN_EMAIL=admin@openfinance.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Super Admin
