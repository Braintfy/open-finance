# =============================================================================
# Open Finance — environment variables (template)
# =============================================================================
# Скопируй в .env.local и заполни. НЕ коммить .env.local в гит!
# Подробности: docs/SECURITY.md

# === Окружение ===
NODE_ENV=development

# === Database (PostgreSQL + pgvector) ===
DATABASE_URL=postgresql://openfinance:openfinance@localhost:5432/openfinance

# === Redis (cache + queue) ===
REDIS_URL=redis://localhost:6379

# === NextAuth ===
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# === AI Providers (по умолчанию пусто, BYOK) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
YANDEX_API_KEY=

# === S3 Storage (для inbox в SaaS) ===
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === Telegram Bot (для уведомлений) ===
TELEGRAM_BOT_TOKEN=

# === Биллинг: Т-Касса ===
TKASSA_TERMINAL_KEY=
TKASSA_TERMINAL_PASSWORD=

# === Биллинг: CloudPayments (резервный) ===
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_PASSWORD=

# === Sentry (мониторинг ошибок) ===
SENTRY_DSN=
