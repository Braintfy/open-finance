{
  "name": "open-finance",
  "version": "0.5.0",
  "private": true,
  "description": "AI-Финансовый Управляющий — модульная платформа финансовой аналитики с AI-секретарём",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "NEXT_TURBO=1 next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "ollama:check": "curl -sS http://localhost:11434/api/tags || echo 'Ollama не запущен. См. docs/LOCAL_AI.md'",
    "db:seed": "tsx scripts/seed.ts",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "admin:create": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
