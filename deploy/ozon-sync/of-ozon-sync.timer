# PURPOSE: Расписание ежедневной синхронизации Ozon — 05:30 МСК.
# Включать нужно ИМЕННО таймер (`systemctl enable --now of-ozon-sync.timer`),
# сам сервис включать не надо. Подробности — deploy/ozon-sync/README.md
[Unit]
Description=Open Finance — ежедневный запуск синхронизации Ozon (05:30 МСК)
Documentation=file:/home/firay/open-finance/deploy/ozon-sync/README.md

[Timer]
# Почему 05:30:
#   - бэкап БД стартует в 03:30 (crontab firay) — к 05:30 он давно закончился;
#   - сутки у Ozon к этому времени закрыты, вчерашний день уже отдаётся
#     аналитикой; окна у стейджей скользящие (30/62/90 дней), поэтому даже
#     недоехавшая реклама за вчера доедет следующим прогоном;
#   - не пересекается с apt-daily (~02:40) и apt-daily-upgrade (~06:10);
#   - результат готов к утру, до того как кто-то откроет дашборд.
# Часовой пояс указан явно: платa стоит на Europe/Moscow, но если её когда-нибудь
# переведут на UTC, расписание не должно уехать.
OnCalendar=*-*-* 05:30:00 Europe/Moscow
# Разброс до 15 минут: не даём таймеру бить в одну секунду с чужими задачами.
RandomizedDelaySec=900
# Плата была выключена в 05:30 — запуск не потеряется, отработает после загрузки.
Persistent=true
AccuracySec=1min
Unit=of-ozon-sync.service

[Install]
WantedBy=timers.target
